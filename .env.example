# Copy to .env.local and fill in what you actually use. Nothing here has a real value.

# ---- Required (today's only provider — every AI_ROUTE_* below falls back to this) ----
ANTHROPIC_API_KEY=

# ---- Supabase (see the rest of the app) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Model router (src/lib/ai/) ----
# With NONE of the AI_ROUTE_* vars set, every task below still resolves to Claude and behaviour is
# unchanged. Set one to move a single task to another provider: AI_ROUTE_<TASK>="provider:model-id".
# Tasks: meal_vision, meal_vision_hard, scan_classify (Claude-only), label_ocr, label_ocr_verify,
#        label_structure, label_analysis (Claude-only — uses web_search), barcode_digits,
#        meal_text_parse, exercise_parse, food_lookup (liveFood.ts), menu_vision (Haiku) and
#        menu_vision_hard (Sonnet fallback, /api/scan-menu). See src/lib/ai/README.md.
#
# AI_ROUTE_MEAL_VISION=qwen:qwen3-vl-plus        # verify the current model id before use
# AI_ROUTE_MEAL_VISION_HARD=gemini:gemini-2.5-pro # verify the current model id before use
# AI_ROUTE_LABEL_OCR=paddleocr:default
# AI_ROUTE_LABEL_OCR_VERIFY=deepseekocr:default
# AI_ROUTE_LABEL_STRUCTURE=qwen:qwen-plus         # verify the current model id before use
# AI_ROUTE_BARCODE_DIGITS=gemini:gemini-2.0-flash # verify the current model id before use
# AI_ROUTE_MEAL_TEXT_PARSE=gemini:gemini-2.0-flash
# AI_ROUTE_EXERCISE_PARSE=gemini:gemini-2.0-flash
# AI_ROUTE_FOOD_LOOKUP=qwen:qwen-plus

# Escalate a meal_vision result to meal_vision_hard when any item's confidence is at/below this.
# Unset (or any other value) = off, which is today's behaviour.
# AI_ESCALATE_BELOW=medium

# ---- Provider keys/URLs (only needed for the AI_ROUTE_* you actually set) ----
GEMINI_API_KEY=
# Qwen: either DashScope international, or an OpenRouter key against the OpenRouter API.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# A local / self-hosted OpenAI-compatible server (vLLM, InternVL, …).
LOCAL_OPENAI_URL=
LOCAL_OPENAI_API_KEY=
# Self-hosted OCR services (see src/lib/ai/providers/paddleocr.ts and deepseekOcr.ts).
PADDLEOCR_URL=
PADDLEOCR_TOKEN=
DEEPSEEK_OCR_URL=
DEEPSEEK_OCR_TOKEN=

# ---- v2.10 admin panel + beta usage events (docs/ADMIN.md) ----
# Comma-separated emails allowed into /admin. Empty = nobody. Everyone else gets a 404.
ADMIN_EMAILS=
# Beta usage events kill switch (bandlog.app_events). Default true; set false and redeploy before public launch.
BETA_ANALYTICS=true
